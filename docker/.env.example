# Copy to docker/.env (git-ignored). Use URL-safe characters in passwords: they are embedded in connection URLs.
ENVIRONMENT=local
LOG_LEVEL=INFO

POSTGRES_PASSWORD=change-me-postgres
REDIS_PASSWORD=change-me-redis
QDRANT_API_KEY=change-me-qdrant
# Neo4j requires at least 8 characters
NEO4J_PASSWORD=change-me-neo4j

# Ollama runs on the host (ollama serve); pull the model first: ollama pull llama3.1
OLLAMA_BASE_URL=http://host.docker.internal:11434
LLM_MODEL=llama3.1

# Auth0 (issuer must end with "/"). Protected routes return 401 until these are set.
AUTH0_ISSUER=
AUTH0_AUDIENCE=

API_HOST=localhost
FRONTEND_PORT=3000
